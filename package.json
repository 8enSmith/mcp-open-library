    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "vitest",
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "test:precommit": "vitest run"
